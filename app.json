{
  "name": "telegram-forward-saver",
  "description": "Pyrogram bot with force-sub, async queue, and protected DM delivery",
  "repository": "https://github.com/example/forward-saver",
  "keywords": ["telegram", "pyrogram", "mongodb", "heroku"],
  "env": {
    "API_ID": {"description": "Telegram API ID", "required": true},
    "API_HASH": {"description": "Telegram API hash", "required": true},
    "BOT_TOKEN": {"description": "Bot token from @BotFather", "required": true},
    "OWNER_ID": {"description": "Admin user id", "required": true},
    "STRING_SESSION": {"description": "Pyrogram string session for user account access", "required": false},
    "FORCE_SUB_ID": {
      "description": "Force-sub channel username or id",
      "required": true,
      "value": "aghoris"
    },
    "MONGO_URL": {"description": "MongoDB URI", "required": true}
  },
  "formation": {
    "worker": {"quantity": 1, "size": "basic"}
  }
}
